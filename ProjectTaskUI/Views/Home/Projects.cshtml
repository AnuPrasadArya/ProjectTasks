@{
    ViewBag.Title = "Projects";
}

<h2>Projects</h2>
<div class="mb-3">
    <button class="btn btn-success" onclick="showProjectForm()">Add Project</button>
    <button class="btn btn-primary" onclick="goToTaskPage()">Add Task</button>
</div>

<div id="projectForm" style="display:none;">
    <input id="projectName" class="form-control mb-2" placeholder="Name" />
    <textarea id="projectDesc" class="form-control mb-2" placeholder="Description"></textarea>
    <button class="btn btn-primary" onclick="createProject()">Save</button>
</div>

<table class="table table-bordered" id="projectsTable" style="display:none;">
    <thead>
        <tr>
            <th>ProjectId</th>
            <th>Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="projectsBody">
        <!-- Project rows will be appended here -->
    </tbody>
</table>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="~/js/projects.js"></script>
