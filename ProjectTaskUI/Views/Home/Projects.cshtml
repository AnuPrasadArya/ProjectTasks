@{
    ViewBag.Title = "Projects";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h2>Projects</h2>
    <button class="btn btn-success mb-3" onclick="showProjectForm()">Add Project</button>
    <div id="projectForm" style="display:none;">
        <input id="projectName" class="form-control mb-2" placeholder="Name" />
        <textarea id="projectDesc" class="form-control mb-2" placeholder="Description"></textarea>
        <button class="btn btn-primary" onclick="createProject()">Save</button>
    </div>

    <ul id="projectsList" class="list-group"></ul>
</div>

<script src="/js/site.js"></script>
<script>
    loadProjects();
</script>

