@{
    ViewBag.Title = "Tasks";
}

<h2>Tasks</h2>

<div class="mb-3">
    <button class="btn btn-success" onclick="showTaskForm()">Add Task</button>
</div>

<div class="mb-3">
    
    <select id="projectSelect" class="form-select" onchange="loadTasksForProject()">
        <option value="">-- Select Project --</option>
    </select>
</div>

<div id="taskForm" style="display:none;">
    <input id="taskTitle" class="form-control mb-2" placeholder="Title" />
    <textarea id="taskDesc" class="form-control mb-2" placeholder="Description"></textarea>
    <input id="taskDueDate" type="date" class="form-control mb-2" />
    <label><input type="checkbox" id="taskCompleted" /> Completed</label>
    <select id="taskProjectSelect" class="form-select mb-2">
        <option value="">-- Select Project --</option>
    </select>
    <button class="btn btn-primary" onclick="createTask()">Save</button>
</div>

<table id="tasksTable" class="table" style="display:none;">
    <thead>
        <tr>
            <th>TaskId</th>
            <th>Title</th>
            <th>Description</th>
            <th>Due Date</th>
            <th>Completed</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="tasksBody"></tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/Task.js"></script>
}
