@{
    ViewBag.Title = "Tasks";
    var projectId = ViewBag.ProjectId;
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h2>Tasks for Project @projectId</h2>
    <button class="btn btn-success mb-3" onclick="showTaskForm()">Add Task</button>
    <div id="taskForm" style="display:none;">
        <input id="taskTitle" class="form-control mb-2" placeholder="Title" />
        <textarea id="taskDesc" class="form-control mb-2" placeholder="Description"></textarea>
        <input id="taskDueDate" type="date" class="form-control mb-2" />
        <button class="btn btn-primary" onclick="createTask(@projectId)">Save</button>
    </div>

    <ul id="tasksList" class="list-group"></ul>
</div>

<script src="/js/site.js"></script>
<script>
    loadTasks(@projectId);
</script>
