@{
    ViewBag.Title = "Tasks";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h2>Tasks</h2>

    <div class="mb-3">
        <label>Project ID:</label>
        <input id="projectId" type="text" class="form-control" placeholder="Enter Project ID" />
        <button class="btn btn-primary mt-2" onclick="loadTasks()">Load Tasks</button>
    </div>

    <button class="btn btn-success mb-3" onclick="showTaskForm()">Add Task</button>

    <div id="taskForm" style="display:none;">
        <input id="taskTitle" class="form-control mb-2" placeholder="Title" />
        <textarea id="taskDesc" class="form-control mb-2" placeholder="Description"></textarea>
        <input id="taskDueDate" type="date" class="form-control mb-2" />
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="taskCompleted">
            <label class="form-check-label" for="taskCompleted">Completed</label>
        </div>
        <button class="btn btn-primary" onclick="createTask()">Save</button>
    </div>

    <ul id="tasksList" class="list-group"></ul>
</div>

<script src="~/js/tasks.js"></script>

